{
  "rules": {
    ".read": false,
    ".write": false,
    "v1": {
      "$space": {
        "rooms": {
          "$code": {
            ".read": "auth != null && $space.matches(/^[0-9a-f]{32}$/) && $code.matches(/^[A-Z2-9]{4}$/)",
            "meta": {
              ".write": "auth != null && !data.exists() && $space.matches(/^[0-9a-f]{32}$/) && $code.matches(/^[A-Z2-9]{4}$/)",
              ".validate": "newData.hasChildren(['host', 'hostColor', 'seed', 'created', 'build'])",
              "host": { ".validate": "newData.val() === auth.uid || data.val() === newData.val()" },
              "hostColor": { ".validate": "newData.val() === 'w' || newData.val() === 'b'" },
              "seed": { ".validate": "newData.isNumber()" },
              "created": { ".validate": "newData.isNumber()" },
              "build": { ".validate": "newData.isString() && newData.val().length < 64" },
              "guest": {
                ".write": "auth != null && data.parent().exists() && !data.exists() && data.parent().child('host').val() !== auth.uid",
                ".validate": "newData.val() === auth.uid"
              },
              "$other": { ".validate": false }
            },
            "actions": {
              "$n": {
                ".write": "auth != null && !data.exists() && (data.parent().parent().child('meta/host').val() === auth.uid || data.parent().parent().child('meta/guest').val() === auth.uid)",
                ".validate": "$n.matches(/^[0-9]{5}$/) && newData.hasChildren(['by', 'a', 'fen'])",
                "by": { ".validate": "newData.val() === auth.uid" },
                "a": { ".validate": "newData.isString() && newData.val().length < 2000" },
                "fen": { ".validate": "newData.isString() && newData.val().length < 100" },
                "$other": { ".validate": false }
              }
            },
            "presence": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.isBoolean()"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
